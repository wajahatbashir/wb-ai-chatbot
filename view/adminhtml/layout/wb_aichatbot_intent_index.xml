        <referenceContainer name="content">
            <block class="WB\AiChatbot\Block\Adminhtml\GridContainer" name="wb_aichatbot_intent_container">
                <arguments>
                    <argument name="header" xsi:type="string">Intent Dictionaries (Assist mode)</argument>
