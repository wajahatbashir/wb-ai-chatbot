    [__('Chats today'), $s['today'], __('%1 yesterday', $s['yesterday'])],
    [__('Chats, 7 days'), $s['week'], __('%1 customer messages', $s['messages_week'])],
    [__('Active now'), $s['active'], __('last 15 minutes')],
    [__('Answered by AI'), $s['ai_share'] . '%', __('of replies, 7 days')],
    [__('Rating'), $s['rating_count'] ? number_format($s['rating_avg'], 1) . ' / 5' : '-', __('%1 rated · 👍 %2 · 👎 %3', $s['rating_count'], $s['thumbs_up'], $s['thumbs_down'])],
    [__('Needs attention'), $s['requests_open'] + $s['unanswered_new'], __('%1 open requests · %2 unanswered', $s['requests_open'], $s['unanswered_new'])],
];
