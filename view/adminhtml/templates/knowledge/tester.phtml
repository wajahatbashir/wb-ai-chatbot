<?php
/** @var \WB\AiChatbot\Block\Adminhtml\Knowledge\Tester $block */
/** @var \Magento\Framework\Escaper $escaper */
$query = $block->getQuery();
$results = $block->getResults();
?>
<style>
    .wb-kb-tester__form { background: #fff; border: 1px solid #e3e3e3; border-radius: 4px; padding: 16px 20px; margin-bottom: 20px; }
    .wb-kb-tester__row { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: flex-end; }
