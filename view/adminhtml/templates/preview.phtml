<script>
require(['jquery'], function ($) {
    'use strict';
    var sendUrl = '<?= $escaper->escapeJs($block->getSendUrl()) ?>';
    var welcome = <?= json_encode($block->getWelcomeMessage()) ?>;
    var questions = <?= json_encode(array_values($questions)) ?>;
    var $list = $('#wb-prev-list'), $debug = $('#wb-prev-debug'), $text = $('#wb-prev-text');

    function esc(s) { return $('<div>').text(s == null ? '' : String(s)).html(); }
    function md(s) {
        var h = esc(s);
        h = h.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        h = h.replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
        h = h.replace(/(^|\s)(https?:\/\/[^\s<]+)/g, '$1<a href="$2" target="_blank" rel="noopener">$2</a>');
        return h;
    }
    function card(c) {
        if (c.type === 'product') {
            return '<div class="wb-prev__card">' + (c.image ? '<img src="' + esc(c.image) + '" alt=""/>' : '') +
                '<div class="wb-prev__card-body"><a class="wb-prev__card-name" href="' + esc(c.url) + '" target="_blank">' + esc(c.name) + '</a>' +
                '<div class="wb-prev__card-price">' + esc(c.price_text) + (c.regular_price_text ? '<s>' + esc(c.regular_price_text) + '</s>' : '') + '</div>' +
                '<span class="wb-prev__card-av wb-prev__card-av--' + esc(c.availability) + '">' + esc(c.availability_label) + '</span></div></div>';
        }
        if (c.type === 'link' || c.type === 'file') {
            return '<div class="wb-prev__card wb-prev__card--wide"><div class="wb-prev__card-body">' + (c.type === 'file' ? '&#128196; ' : '&#128279; ') +
                '<a href="' + esc(c.url) + '" target="_blank">' + esc(c.label) + '</a>' + (c.description ? '<div style="color:#777">' + esc(c.description) + '</div>' : '') + '</div></div>';
        }
        if (c.type === 'order') {
            var items = (c.items || []).map(function (i) { return '<li>' + esc(i.name) + ' × ' + esc(i.qty) + ' – ' + esc(i.price) + '</li>'; }).join('');
            return '<div class="wb-prev__card wb-prev__card--wide"><div class="wb-prev__card-body"><strong>Order ' + esc(c.increment_id) + '</strong> · ' + esc(c.status) + ' · ' + esc(c.created_at) +
                '<ul style="margin:6px 0 0 16px;padding:0">' + items + '</ul><div>Total ' + esc(c.grand_total) + '</div></div></div>';
        }
        if (c.type === 'table') {
            var head = '<tr>' + (c.columns || []).map(function (x) { return '<th>' + esc(x) + '</th>'; }).join('') + '</tr>';
            var rows = (c.rows || []).map(function (r) { return '<tr>' + r.map(function (x) { return '<td>' + esc(x) + '</td>'; }).join('') + '</tr>'; }).join('');
            return '<div class="wb-prev__card wb-prev__card--wide"><div class="wb-prev__card-body"><table class="wb-prev__table">' + head + rows + '</table></div></div>';
        }
        return '';
    }
    function bubble(role, text, cards, chips, notice) {
        $('.wb-prev__chips').remove();
        var html = '<div class="wb-prev__msg wb-prev__msg--' + (role === 'user' ? 'user' : 'bot') + '">' + md(text) + '</div>';
        if (notice) { html += '<div class="wb-prev__notice">' + esc(notice) + '</div>'; }
        if (cards && cards.length) { html += '<div class="wb-prev__cards">' + cards.map(card).join('') + '</div>'; }
        if (chips && chips.length) {
            html += '<div class="wb-prev__chips">' + chips.map(function (ch) {
                return '<button type="button" class="wb-prev__chip" data-send="' + esc(ch.send || ch.label) + '">' + esc(ch.label) + '</button>';
            }).join('') + '</div>';
        }
        $list.append(html);
        $list.scrollTop($list[0].scrollHeight);
    }
    function debug(d) {
        if (!d) { return; }
        var kv = [['Mode', d.mode], ['Model', d.model || '-'], ['Credential', d.credential_id || '-'],
            ['Tokens', (d.prompt_tokens || 0) + ' in / ' + (d.completion_tokens || 0) + ' out'], ['Cost', '$' + Number(d.cost || 0).toFixed(6)],
            ['Latency', (d.latency_ms || 0) + ' ms'], ['Grounded', d.grounded ? 'yes' : 'no'], ['Unanswered', d.unanswered ? 'flagged' : 'no']];
        var html = '<h3>Last reply - under the hood</h3><dl class="wb-prev__kv">' + kv.map(function (p) { return '<dt>' + esc(p[0]) + '</dt><dd>' + esc(p[1]) + '</dd>'; }).join('') + '</dl>';
        html += '<strong>Tool calls</strong><pre>' + esc(d.tool_calls && d.tool_calls.length ? JSON.stringify(d.tool_calls, null, 1) : 'none') + '</pre>';
        html += '<strong>Sources</strong><pre>' + esc(d.sources && d.sources.length ? d.sources.map(function (s) { return (s.confidence != null ? '[' + s.confidence + '] ' : '') + s.title + (s.url ? ' - ' + s.url : ''); }).join('\n') : 'none') + '</pre>';
        $debug.html(html);
        $('#wb-prev-mode').text(d.mode === 'ai' ? 'AI' : 'Assist').toggleClass('wb-prev__badge--assist', d.mode !== 'ai');
    }
    function post(data) {
        data.form_key = window.FORM_KEY;
        data.store = $('#wb-prev-store').val();
        return $.post(sendUrl, data);
    }
    function send(text) {
        text = $.trim(text);
        if (!text) { return; }
        bubble('user', text);
        $text.val('');
        $list.append('<div class="wb-prev__typing" id="wb-prev-typing">' + esc('<?= $escaper->escapeJs($block->getAssistantName()) ?>') + ' is typing…</div>');
        $list.scrollTop($list[0].scrollHeight);
        post({message: text}).done(function (r) {
            $('#wb-prev-typing').remove();
            if (!r.ok) { bubble('bot', 'Error: ' + (r.message || 'unknown')); return; }
            bubble('bot', r.reply.text, r.reply.cards, r.reply.chips, r.reply.notice);
            debug(r.reply.debug);
        }).fail(function (xhr) {
            $('#wb-prev-typing').remove();
            bubble('bot', 'Request failed (' + xhr.status + '). Check var/log/wb_aichatbot.log.');
        });
    }
    function load() {
        $list.empty();
        post({action: 'history'}).done(function (r) {
            if (r.messages && r.messages.length) {
                r.messages.forEach(function (m) { bubble(m.role, m.text, m.cards); });
                var last = r.messages[r.messages.length - 1];
                if (last.role === 'assistant') { debug({mode: last.mode, model: last.model, prompt_tokens: last.tokens, latency_ms: last.latency_ms, grounded: last.grounded, tool_calls: last.tool_calls, sources: last.sources}); }
            } else {
                bubble('bot', welcome, [], questions.map(function (q) { return {label: q, send: q}; }));
            }
        });
    }
    $('#wb-prev-form').on('submit', function (e) { e.preventDefault(); send($text.val()); });
    $list.on('click', '.wb-prev__chip', function () { send($(this).data('send')); });
    $('#wb-prev-reset').on('click', function () { post({action: 'reset'}).done(load); });
    $('#wb-prev-store').on('change', load);
    load();
});
</script>
