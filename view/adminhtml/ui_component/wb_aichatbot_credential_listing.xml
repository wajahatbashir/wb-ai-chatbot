<?xml version="1.0" ?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">wb_aichatbot_credential_listing.wb_aichatbot_credential_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>wb_aichatbot_credential_columns</spinner>
        <deps>
            <dep>wb_aichatbot_credential_listing.wb_aichatbot_credential_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="wb_aichatbot_credential_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">credential_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>WB_AiChatbot::credentials</aclResource>
        <dataProvider class="WB\AiChatbot\Ui\Component\Listing\DataProvider" name="wb_aichatbot_credential_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>credential_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="status_enable">
                <settings>
                    <url path="wb_aichatbot/credential/massStatus">
                        <param name="status">1</param>
                    </url>
                    <type>status_enable</type>
                    <label translate="true">Enable</label>
                </settings>
            </action>
            <action name="status_disable">
                <settings>
                    <url path="wb_aichatbot/credential/massStatus">
                        <param name="status">0</param>
                    </url>
                    <type>status_disable</type>
                    <label translate="true">Disable</label>
                </settings>
            </action>
            <action name="delete">
                <settings>
                    <url path="wb_aichatbot/credential/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                    <confirm>
                        <title translate="true">Delete credentials</title>
                        <message translate="true">Are you sure you want to delete the selected provider credentials?</message>
                    </confirm>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="wb_aichatbot_credential_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>credential_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="credential_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="sort_order">
            <settings>
                <filter>textRange</filter>
                <sorting>asc</sorting>
                <label translate="true">Order</label>
            </settings>
        </column>
        <column name="alias">
            <settings>
                <filter>text</filter>
                <label translate="true">Alias</label>
            </settings>
        </column>
        <column name="provider_code" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <options class="WB\AiChatbot\Model\Source\ProviderCode"/>
                <dataType>select</dataType>
                <label translate="true">Provider</label>
            </settings>
        </column>
        <column name="model">
            <settings>
                <filter>text</filter>
                <label translate="true">Chat Model</label>
            </settings>
        </column>
        <column name="embedding_model">
            <settings>
                <filter>text</filter>
                <label translate="true">Embedding Model</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="is_enabled" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <dataType>select</dataType>
                <label translate="true">Enabled</label>
            </settings>
        </column>
        <column name="status_badge" class="WB\AiChatbot\Ui\Component\Listing\Columns\StatusBadge">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <sortable>false</sortable>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <options class="WB\AiChatbot\Model\Source\Status"/>
                <dataType>select</dataType>
                <label translate="true">Status Code</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="status_message">
            <settings>
                <filter>text</filter>
                <label translate="true">Last Message</label>
            </settings>
        </column>
        <column name="last_checked_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Last Checked</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="WB\AiChatbot\Ui\Component\Listing\Columns\CredentialActions">
            <settings>
                <indexField>credential_id</indexField>
                <resizeEnabled>false</resizeEnabled>
                <resizeDefaultWidth>107</resizeDefaultWidth>
            </settings>
        </actionsColumn>
    </columns>
</listing>
