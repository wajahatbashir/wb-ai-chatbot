<?xml version="1.0" ?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">wb_aichatbot_knowledge_listing.wb_aichatbot_knowledge_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>wb_aichatbot_knowledge_columns</spinner>
        <deps>
            <dep>wb_aichatbot_knowledge_listing.wb_aichatbot_knowledge_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="wb_aichatbot_knowledge_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">document_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>WB_AiChatbot::knowledge</aclResource>
        <dataProvider class="WB\AiChatbot\Ui\Component\Listing\KnowledgeDataProvider" name="wb_aichatbot_knowledge_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>document_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="status_enable">
                <settings>
                    <url path="wb_aichatbot/knowledge/massStatus">
                        <param name="status">1</param>
                    </url>
                    <type>status_enable</type>
                    <label translate="true">Enable</label>
                </settings>
            </action>
            <action name="status_disable">
                <settings>
                    <url path="wb_aichatbot/knowledge/massStatus">
                        <param name="status">0</param>
                    </url>
                    <type>status_disable</type>
                    <label translate="true">Disable (exclude from answers)</label>
                </settings>
            </action>
            <action name="reindex">
                <settings>
                    <url path="wb_aichatbot/knowledge/massReindex"/>
                    <type>reindex</type>
                    <label translate="true">Re-sync &amp; index</label>
                </settings>
            </action>
            <action name="delete">
                <settings>
                    <url path="wb_aichatbot/knowledge/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                    <confirm>
                        <title translate="true">Delete documents</title>
                        <message translate="true">Delete the selected documents? Synced documents come back on the next sync unless disabled.</message>
                    </confirm>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="wb_aichatbot_knowledge_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>document_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="document_id">
            <settings>
                <filter>textRange</filter>
                <sorting>desc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="title">
            <settings>
                <filter>text</filter>
                <label translate="true">Title</label>
            </settings>
        </column>
        <column name="source_type" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <options class="WB\AiChatbot\Model\Source\KbSourceType"/>
                <dataType>select</dataType>
                <label translate="true">Source</label>
            </settings>
        </column>
        <column name="identifier">
            <settings>
                <filter>text</filter>
                <label translate="true">Identifier</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="store_id" class="Magento\Store\Ui\Component\Listing\Column\Store">
            <settings>
                <label translate="true">Store View</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="sync_status" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <options class="WB\AiChatbot\Model\Source\KbSyncStatus"/>
                <dataType>select</dataType>
                <label translate="true">Index Status</label>
            </settings>
        </column>
        <column name="is_enabled" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <dataType>select</dataType>
                <label translate="true">Enabled</label>
            </settings>
        </column>
        <column name="chunks">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Chunks</label>
            </settings>
        </column>
        <column name="embedded">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Embedded</label>
            </settings>
        </column>
        <column name="body_excerpt">
            <settings>
                <sortable>false</sortable>
                <label translate="true">Excerpt</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="url">
            <settings>
                <filter>text</filter>
                <label translate="true">URL</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="WB\AiChatbot\Ui\Component\Listing\Columns\KnowledgeActions">
            <settings>
                <indexField>document_id</indexField>
                <resizeEnabled>false</resizeEnabled>
                <resizeDefaultWidth>107</resizeDefaultWidth>
            </settings>
        </actionsColumn>
    </columns>
</listing>
